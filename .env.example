DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=5000
# Must equal FinanceTracker's SESSION_SECRET (not a JWT_SECRET — FinanceTracker's own Render
# deployment doesn't set one, and its jwtService.ts falls back to SESSION_SECRET for signing).
# Login happens against FinanceTracker, this backend only verifies the token it issues.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
